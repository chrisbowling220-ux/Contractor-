# BuildPro+ build-time configuration.
#
# Vite inlines every VITE_* value into the bundle when `npm run build` runs, so
# these MUST be present in the build environment (local .env.local, or your
# host's build/CI env vars) BEFORE you build & deploy. A build made without them
# ships an app that can't start — the site will show a "isn't finished setting
# up" screen listing whatever is missing.
#
# Copy this file to `.env.local` and fill in real values. Never commit the
# filled-in file (.env* is gitignored).

# Clerk — sign-in / auth. Publishable key from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Firebase — from Firebase console → Project settings → Your apps (Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Stripe — publishable key for the customer payout/checkout flow (optional for
# core app load; required for payments).
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
